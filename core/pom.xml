<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.efti.tst</groupId>
        <artifactId>tst-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>core</artifactId>

    <dependencies>
        <!-- XPath 3.1 for the format descriptor and XSLT 3.0 to run the Schematron rules -->
        <dependency>
            <groupId>net.sf.saxon</groupId>
            <artifactId>Saxon-HE</artifactId>
            <version>12.10</version>
        </dependency>
        <!-- Schematron to XSLT transpiler (a single XSLT file executed by Saxon) -->
        <dependency>
            <groupId>name.dmaus.schxslt</groupId>
            <artifactId>schxslt2</artifactId>
            <version>1.11.2</version>
        </dependency>
        <!-- JSON report output; Jackson 3 supports records and java.time out of the box -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <!-- FormatContractTest reads the catalogue of test data sets -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
